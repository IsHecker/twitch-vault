# Add a new migration
dotnet ef migrations add <MigrationName> --project src/TwitchVault.Api --startup-project src/TwitchVault.Api --output-dir Persistence\Database\Migrations

# Apply migrations to the database
dotnet ef database update --project src/TwitchVault.Api --startup-project src/TwitchVault.Api

# Remove the last migration (before applying to DB)
dotnet ef migrations remove --project src/TwitchVault.Api --startup-project src/TwitchVault.Api


# Restore dependencies
dotnet restore

# Build the project
dotnet build


# Publish the API project to a 'publish' folder
dotnet publish src/Wesal.Api/Wesal.Api.csproj -c Release -o ./publish
    </Reference>
    <Reference Include="PolyStore.Core">
      <HintPath>lib\PolyStore.Core.dll</HintPath>
    </Reference>
    <Reference Include="PolyStore.Providers">
      <HintPath>lib\PolyStore.Providers.dll</HintPath>
    </Reference>

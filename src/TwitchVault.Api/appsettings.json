{
  "Paths": {
    "Database": "Database.json",
    "Streams": "Streams",
    "Logs": "Logs",
    "BaseUrl": "https://localhost:7144"
  },
  "Vault": {
    "MaxSegmentDurationInSec": 10,
    "MaxConsecutiveEmptyPolls": 3,
    "UploadBatchSize": 10,
    "MaxConcurrentUploadWorkers": 5,
    "IdleFlushTimeoutSeconds": 8,
    "MaxSubscriptionsPerUser": 3,
    "DefaultQualityRank": 2,
    "MaxQualityRank": 6
  },
  "BackgroundJobs": {
    "ChannelMonitor": {
      "Enabled": false,
      "RunIntervalInMinutes": 1
    },
    "TwitchWebhookHealthCheck": {
      "Enabled": false,
      "RunIntervalInMinutes": 1
    },
    "StorageUpload": {
      "Enabled": false,
      "RunIntervalInMinutes": 2
    },
    "StorageCleanup": {
      "Enabled": true,
      "RunIntervalInMinutes": 0.1
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.SQLite",
      "Serilog.Sinks.Async",
      "Serilog.Enrichers.Thread",
      "TwitchVault.Api"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "TwitchVault": "Information",
        "Microsoft": "Warning",
        "System": "Warning",
        "Quartz": "Warning",
        "Polly": "Fatal",
        "PolyStore": "Fatal",
        "Microsoft.EntityFrameworkCore": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [T:{ThreadId}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/twitchvault-.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 7,
                "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] [T:{ThreadId}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "SQLite",
              "Args": {
                "sqliteDbPath": "logs.db",
                "tableName": "Logs",
                "storeTimestampInUtc": false
              }
            }
          ],
          "bufferSize": 50000,
          "blockWhenFull": false
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId",
      "WithEgyptTime"
    ]
  }
}